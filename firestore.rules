rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products Collection
    match /products/{productId} {
      // Anyone can read product catalog
      allow read: if true;
      // Only the verified store owner can add, edit, or delete products
      allow write: if request.auth != null && 
        request.auth.token.email.lower() == 'beingmagrajwork@gmail.com';
    }
  }
}
